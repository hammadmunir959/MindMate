##############################################
# Core Application Settings
##############################################
APP_NAME=MindMate
APP_VERSION=2.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

##############################################
# Security & JWT Settings
##############################################
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

##############################################
# Database Settings
##############################################
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindmatedb
DB_MAX_CONNECTIONS=20
DB_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_ECHO=false

##############################################
# Redis Settings
##############################################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

##############################################
# Email / SMTP Settings
##############################################
# Note: In config, SMTP_SERVER can also be configured via SMTP_URL
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=MindMate

##############################################
# Admin Settings
##############################################
ADMIN_REGISTRATION_KEY=your_admin_registration_key
ADMIN_REGISTRATION_KEY_HASH=your_admin_registration_key_hash
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=User
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password

##############################################
# Agent & LLM Provider Settings
##############################################
# Qwen (Primary)
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Groq (1st Fallback)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (2nd Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://api.openrouter.ai/v1
OPENROUTER_MODEL=google/gemini-2.0-flash:free

# Cerebras (3rd Fallback)
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama3.1-70b

# General LLM Settings
SUMMARIZER_LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# PIA Workflow Settings
SUMMARIZE_EVERY_N=8
INITIAL_MODULE=SCID_SC
